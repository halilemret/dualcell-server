{
  "expo": {
    "name": "DualCall",
    "slug": "dualcall",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "dualcall",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F19",
    "ios": {
      "bundleIdentifier": "com.dualcall.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Sesli köprü için mikrofon gerekir.",
        "NSCameraUsageDescription": "Eşleşme kodlarını taramak için kameraya erişim gereklidir.",
        "NSContactsUsageDescription": "Gelen aramaları kişilere eşleştirmek için gereklidir.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.dualcall.app",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Kamera kullanılmaz; ses köprüsü için gereklidir.",
          "microphonePermission": "Sesli köprü için mikrofon gerekir."
        }
      ],
      "./plugins/withDualCallAndroid",
      "./plugins/withDualCallIos"
    ],
    "extra": {
      "serverUrl": "https://dualcell-relay.onrender.com",
      "eas": {
        "projectId": "ea82d395-b44b-4624-95f0-2791cc6826df"
      }
    },
    "owner": "halilemre"
  }
}
